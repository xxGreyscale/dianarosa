# Public environment variables (exposed to the client — must be prefixed with VITE_)

# Optional: production site URL — used in canonical/OG meta tags
VITE_SITE_URL=https://dianaroselogistics.com

# Optional: Google reCAPTCHA v2 site key (replace placeholder checkbox in forms)
VITE_RECAPTCHA_SITE_KEY=

# Optional: Form submission endpoint (eg. Formspree / custom backend)
VITE_FORM_ENDPOINT=
